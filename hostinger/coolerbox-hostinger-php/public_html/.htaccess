# CoolerBox Ice Hub — Hostinger Apache / LiteSpeed Configuration
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Force HTTPS on coolerboxicehub.com (Hostinger SSL)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} ^(www\.)?coolerboxicehub\.com$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Block direct web access to sensitive internal directories and files
    RewriteRule ^(config|includes|views|database)/ - [F,L]
    RewriteRule \.(sql|db|sqlite|env|ini|log|md)$ - [F,L]

    # 3. Map /assets/* -> /static/assets/*
    RewriteCond %{REQUEST_URI} ^/assets/(.+)$
    RewriteCond %{DOCUMENT_ROOT}/static/assets/%1 -f
    RewriteRule ^assets/(.+)$ static/assets/$1 [L]

    # 4. Map root-level CSS/JS/media requests (e.g., /ice-company.css, /hero-ice.js) -> /static/*
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/static/$1 -f
    RewriteRule ^([^/]+\.(?:css|js|png|jpg|jpeg|webp|svg|ico|mp4|webm))$ static/$1 [L]

    # 5. Serve existing static/upload files directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 6. Route all remaining requests to index.php front controller
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
